{
  "name": "frame-skin-free",
  "version": "1.0.1",
  "private": true,
  "description": "Free, local Figma frame theme plugin without Variables Modes",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/run.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:ui": "npm run build && node scripts/test-ui.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.117.0",
    "@types/node": "22.15.30",
    "esbuild": "0.25.5",
    "playwright-core": "1.52.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
